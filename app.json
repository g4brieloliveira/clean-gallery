{
  "expo": {
    "name": "Kleen",
    "slug": "kleen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "locales": {
      "pt-BR": "./locales/pt-BR.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "bundleIdentifier": "com.g4brieloliveira.kleen",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O Kleen precisa acessar suas fotos e vídeos para você revisar e organizar sua biblioteca.",
        "NSPhotoLibraryAddUsageDescription": "O Kleen pode salvar as alterações que você autorizar na sua fototeca.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.g4brieloliveira.kleen",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9088F0"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir que o Kleen acesse suas fotos para revisar e organizar sua biblioteca.",
          "savePhotosPermission": "Permitir que o Kleen salve alterações autorizadas na sua biblioteca.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#9088F0"
        }
      ],
      "expo-localization",
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "85d9c103-3742-4f08-ab76-e894dda28196"
      }
    },
    "owner": "g4brieloliveira"
  }
}
