{
  "expo": {
    "name": "clean-gallery",
    "slug": "clean-gallery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O app precisa acessar suas fotos e vídeos para você revisar e limpar a galeria.",
        "NSPhotoLibraryAddUsageDescription": "O app pode precisar salvar alterações na biblioteca de fotos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir que o Clean Gallery acesse suas fotos para limpar a galeria.",
          "savePhotosPermission": "Permitir que o Clean Gallery salve fotos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-video"
    ]
  }
}
