{
  "expo": {
    "name": "Kleen",
    "slug": "kleen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D12"
    },
    "ios": {
      "bundleIdentifier": "com.g4brieloliveira.kleen",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "A Kleen precisa acessar suas fotos e vídeos para você revisar e organizar sua biblioteca.",
        "NSPhotoLibraryAddUsageDescription": "A Kleen pode precisar salvar alterações autorizadas na sua biblioteca de fotos."
      }
    },
    "android": {
      "package": "com.g4brieloliveira.kleen",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5142C7"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir que a Kleen acesse suas fotos para revisar e organizar sua biblioteca.",
          "savePhotosPermission": "Permitir que a Kleen salve alterações autorizadas na sua biblioteca.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "85d9c103-3742-4f08-ab76-e894dda28196"
      }
    },
    "owner": "g4brieloliveira"
  }
}
